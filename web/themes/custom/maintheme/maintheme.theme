<?php

/**
 * @file
 * Main Theme theme file.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_page_title().
 */
function maintheme_preprocess_page_title(array &$variables): void {
  $variables['hide_page_title'] = in_array(\Drupal::routeMatch()->getRouteName(), [
    'contact.site_page',
    'entity.contact_form.canonical',
  ], TRUE);
}

/**
 * Removes the generic container wrapper added around rendered Views.
 *
 * Implements hook_theme_suggestions_HOOK_alter() for container templates.
 */
function maintheme_theme_suggestions_container_alter(array &$suggestions, array $variables): void {
  $classes = $variables['element']['#attributes']['class'] ?? [];
  if (in_array('views-element-container', $classes, TRUE) || isset($variables['element']['#view'])) {
    $suggestions[] = 'container__views_element_container';
  }
}

/**
 * Exposes whether analytics should run for the current host.
 *
 * Implements hook_preprocess_html().
 */
function maintheme_preprocess_html(array &$variables): void {
  $host = strtolower(\Drupal::request()->getHost());
  $local_hosts = ['localhost', '127.0.0.1', '::1'];
  $local_suffixes = ['.localhost', '.local', '.test'];

  $is_local = in_array($host, $local_hosts, TRUE);
  foreach ($local_suffixes as $suffix) {
    $is_local = $is_local || str_ends_with($host, $suffix);
  }

  $variables['matomo_enabled'] = !$is_local;
}

/**
 * Varies the rendered page when the same Drupal site serves multiple hosts.
 *
 * Implements hook_page_attachments().
 */
function maintheme_page_attachments(array &$attachments): void {
  $attachments['#cache']['contexts'][] = 'url.site';
}

/**
 * Adds Bootstrap sizing to match-result player legends.
 *
 * Implements hook_preprocess_fieldset().
 */
function maintheme_preprocess_fieldset(array &$variables): void {
  $classes = $variables['element']['#attributes']['class'] ?? [];
  if (in_array('backgammon-result-player', $classes, TRUE)) {
    $variables['legend']['attributes']->addClass('fs-4');
  }
}

/**
 * Uses only Bootstrap's visual classes on the match-result submit button.
 *
 * Implements hook_preprocess_input().
 */
function maintheme_preprocess_input(array &$variables): void {
  if (isset($variables['attributes']['data-match-result-submit'])) {
    $classes = $variables['attributes']['class'] ?? [];
    $variables['attributes']['class'] = array_values(array_diff(
      $classes,
      ['button', 'button--primary'],
    ));
    $variables['attributes']['class'][] = 'btn';
    $variables['attributes']['class'][] = 'btn-primary';
    unset($variables['attributes']['data-match-result-submit']);
  }
}

/**
 * Displays the contact form labels as placeholders.
 *
 * The labels remain in the markup for screen readers but are visually hidden.
 *
 * Implements hook_form_FORM_ID_alter().
 */
function maintheme_form_contact_message_form_alter(array &$form, FormStateInterface $form_state): void {
  $fields = [
    &$form['name'],
    &$form['mail'],
    &$form['subject']['widget'][0]['value'],
    &$form['message']['widget'][0]['value'],
  ];

  foreach ($fields as &$field) {
    if (!empty($field['#title'])) {
      $field['#attributes']['placeholder'] = (string) $field['#title'];
      $field['#title_display'] = 'invisible';
    }
  }
}

/**
 * Change class on user login buttons all to primary.
 *
 * Implements hook_form_alter().
 */
function maintheme_form_alter(array &$form, FormStateInterface $form_state, $form_id) {

  if (in_array($form_id, [
    'user_login_form',
    'user_pass',
    'user_register_form',
  ])) {

    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#attributes']['class'] = [
        'btn',
        'btn-primary',
      ];
    }

  }

}
