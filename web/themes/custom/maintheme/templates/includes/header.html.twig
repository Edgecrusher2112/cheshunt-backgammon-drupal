{# Shared Bootstrap header. Replace the sample items with drupal_menu('main'). #}
<header role="banner" class="site-header">
  <nav class="navbar" aria-label="{{ 'Main navigation'|t }}">
    <div class="{{ b5_top_container|default('container') }}">
      <a class="navbar-brand d-flex align-items-center fw-bold" href="{{ front_page }}" aria-label="{{ 'Cheshunt Backgammon home'|t }}">
        <img class="site-logo" src="{{ base_path ~ directory }}/logo.svg" alt="" width="52" height="52">
        <span class="site-brand-text d-none d-md-block">
          <span class="d-block">{{ 'Cheshunt Backgammon'|t }}</span>
          <span class="site-strapline d-block fw-normal">{{ 'Backgammon In East Herts'|t }}</span>
        </span>
      </a>
      <div class="d-flex align-items-center ms-auto">
        {% if logged_in %}
          <div role="navigation" aria-label="{{ 'Account navigation'|t }}">
            {{ drupal_menu('account') }}
          </div>
        {% endif %}
        <button id="theme-toggle" class="theme-toggle btn" type="button"
                aria-label="{{ 'Switch to dark mode'|t }}" title="{{ 'Switch to dark mode'|t }}">
          <i class="theme-toggle__icon theme-toggle__icon--dark bi bi-moon-stars-fill" aria-hidden="true"></i>
          <i class="theme-toggle__icon theme-toggle__icon--light bi bi-sun-fill" aria-hidden="true"></i>
        </button>
        <button class="navbar-toggler ms-0" type="button" data-bs-toggle="offcanvas"
                data-bs-target="#site-navigation" aria-controls="site-navigation"
                aria-expanded="false" aria-label="{{ 'Toggle navigation'|t }}">
          <span class="navbar-toggler-icon"></span>
        </button>
      </div>
      <div class="offcanvas offcanvas-end site-navigation-offcanvas" tabindex="-1"
           id="site-navigation" aria-labelledby="site-navigation-title">
        <div class="offcanvas-header">
          <h2 class="offcanvas-title fs-4" id="site-navigation-title">{{ 'Menu'|t }}</h2>
          <button class="btn-close" type="button" data-bs-dismiss="offcanvas"
                  aria-label="{{ 'Close navigation'|t }}"></button>
        </div>
        <div class="offcanvas-body">
          <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="/about">{{ 'About'|t }}</a></li>
            <li class="nav-item"><a class="nav-link" href="/rules-etiquette">{{ 'Rules & Etiquette'|t }}</a></li>
            <li class="
            nav-item"><a class="nav-link" href="/contact">{{ 'Contact'|t }}</a></li>
            {% if not logged_in %}
              <li class="nav-item"><a class="nav-link" href="{{ path('user.login') }}">{{ 'Login'|t }}</a></li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>
