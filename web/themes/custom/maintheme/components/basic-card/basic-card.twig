<div class="card bg-body-tertiary shadow-sm {{ margin|default('mb-4') }}">
  {% if title %}
    <div class="card-header {{ header_classes|default('') }}">
      <h2 class="fs-5 mb-0">{{ title }}</h2>
    </div>
  {% endif %}

  <div class="card-body {{ padding|default('p-3') }}">
    {{ content }}
  </div>
</div>
