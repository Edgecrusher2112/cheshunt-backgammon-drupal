{
  "name": "maintheme",
  "version": "1.0.0",
  "description": "[Bootstrap 5](https://www.drupal.org/project/bootstrap5) subtheme.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "sass": "sass --quiet-deps --silence-deprecation=abs-percent,import,global-builtin,color-functions scss/style.scss css/style.css --watch",
