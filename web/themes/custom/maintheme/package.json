    "postinstall": "npm run assets:fontawesome"
  },
  "devDependencies": {
    "sass": "^1.94.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "bootstrap-icons": "^1.13.1"
  }
}
